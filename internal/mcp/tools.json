  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Search session history and return compact event-ranked handles. By default, searches user_input and assistant_response events. Select tool_call or tool_response with event_types for raw tool evidence, then use open on a returned turn_id or session_id for full context.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "event_types": {
          "default": [
            "user_input",
            "assistant_response"
          ],
          "description": "Optional normalized event type filter. Defaults to user_input and assistant_response. Select tool_call or tool_response explicitly for raw tool evidence.",
          "items": {
            "enum": [
              "user_input",
              "assistant_response",
              "reasoning",
              "tool_call",
              "tool_response",
              "compaction",
              "system",
              "runtime"
            ],
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "harness": {
          "description": "Optional exact, case-sensitive normalized harness filter. Supported values: codex, claude-code, cursor, hermes, kiro-cli, kimi-cli, nac, opencode, pi-coding-agent, prime-agent, qwen-code.",
          "type": [
            "string",
            "null"
          ]
        },
        "n_hits": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "Keyword (BM25) search query. Matching is bag-of-words: quotes and punctuation are ignored, and a quoted phrase is matched as independent terms subject to the configured minimum-match threshold, not as an exact phrase.",
          "type": "string"
        },
        "source": {
          "description": "Optional exact, case-sensitive ingest source filter. Configured values for this server: claude, claude-cowork, codex, cursor, cursor-sqlite, hermes, kimi-cli, omp, opencode, pi, prime-agent, prime-agent-subagents. Use source to distinguish sources such as pi and omp that share a harness.",
          "type": [
            "string",
            "null"
          ]
        },
        "within_id": {
          "description": "Optional session:... or turn:... ID to constrain search scope.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
