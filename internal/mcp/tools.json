  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "List sessions that overlap a start/end datetime range. Returns typed session IDs, compact metadata, pagination, and open handles. Use this for metadata browsing by time; use search_sessions for content search and open to inspect a selected session.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "Opaque cursor from a previous list_sessions response with the same filter and sort values.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_datetime": {
          "description": "Exclusive upper bound for session activity. Must be RFC 3339 / ISO 8601 with an explicit timezone and later than start_datetime.",
          "type": "string"
        },
        "harness": {
          "description": "Optional exact, case-sensitive normalized harness filter. Supported values: codex, claude-code, cursor, hermes, kiro-cli, kimi-cli, nac, opencode, pi-coding-agent, prime-agent, qwen-code.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 20,
          "maximum": 25,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "web_search",
                "mcp_internal",
                "tool_calling",
                "chat"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional session mode filter."
        },
        "sort": {
          "anyOf": [
            {
              "enum": [
                "desc",
                "asc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "desc",
          "description": "Sort order by session updated_at and session ID."
        },
        "source": {
          "description": "Optional exact, case-sensitive ingest source filter. Configured values for this server: claude, claude-cowork, codex, cursor, cursor-sqlite, hermes, kimi-cli, omp, opencode, pi, prime-agent, prime-agent-subagents. Use source to distinguish sources such as pi and omp that share a harness.",
          "type": [
            "string",
            "null"
          ]
        },
        "start_datetime": {
          "description": "Inclusive lower bound for session activity. Must be RFC 3339 / ISO 8601 with an explicit timezone, for example 2026-04-30T09:00:00-04:00 or 2026-04-30T13:00:00Z.",
          "type": "string"
        }
      },
      "required": [
        "start_datetime",
        "end_datetime"
      ],
      "type": "object"
    },
