  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Show every session that touched a file, across every worktree, drillable through open. Given a path, returns the agent-attention history of that file \u2014 edits, reads, and aborted attempts in the main checkout, sibling worktrees, and agent-isolation worktrees \u2014 as time-ordered typed session/event IDs. Unlike git blame, this includes work that never landed in git. Matching is by the repo-relative path tail; pass a path specific enough (not a bare basename) and check the surfaced roots for over-match.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "end_datetime": {
          "description": "Optional exclusive upper bound (RFC 3339 with explicit timezone) on touch time; must be later than start_datetime.",
          "type": [
            "string",
            "null"
          ]
        },
        "granularity": {
          "anyOf": [
            {
              "enum": [
                "sessions",
                "events"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "sessions",
          "description": "sessions (default) returns one rollup per session; events returns the flat touch-by-touch timeline."
        },
        "harness": {
          "description": "Optional exact, case-sensitive normalized harness filter. Supported values: codex, claude-code, cursor, hermes, kiro-cli, kimi-cli, nac, opencode, pi-coding-agent, prime-agent, qwen-code.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 25,
          "description": "Maximum sessions (or events) returned in the body. Summary and roots are computed over all matched touches regardless.",
          "maximum": 25,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mutations_only": {
          "default": false,
          "description": "Exclude pure reads (tools named Read) when true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "path": {
          "description": "File to trace. Absolute paths are reduced to a repo-relative tail (by walking up to .git); a repo-relative path is used as the tail directly and gives the best cross-worktree coverage.",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "project",
                "all"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "project",
          "description": "project (default) restricts results to the normalized launch-project identity even without --project-only; all is the deliberate widening path on an unscoped server. A configured --project-only origin boundary remains enforced."
        },
        "source": {
          "description": "Optional exact, case-sensitive ingest source filter. Configured values for this server: claude, claude-cowork, codex, cursor, cursor-sqlite, hermes, kimi-cli, omp, opencode, pi, prime-agent, prime-agent-subagents. Use source to distinguish sources such as pi and omp that share a harness.",
          "type": [
            "string",
            "null"
          ]
        },
        "start_datetime": {
          "description": "Optional inclusive lower bound (RFC 3339 with explicit timezone) on touch time.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "Optional case-insensitive tool-name filter (e.g. Edit, Write, Read, Bash).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "file_attention",
