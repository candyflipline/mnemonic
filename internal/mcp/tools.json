          ],
          "type": "object"
        },
        "request": {},
        "schema_version": {
          "type": "string"
        },
        "tool": {
          "const": "list_sessions"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
